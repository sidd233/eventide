# Copy to .env for local overrides. All optional.
EVENTIDE_CORS_ORIGINS=["http://localhost:5173"]
EVENTIDE_MAX_OBJECTS=350
EVENTIDE_DEFAULT_WINDOW_HOURS=48
# Set to false for a pure real-data run (no injected synthetic conjunction).
EVENTIDE_DEMO_INJECT_SCENARIO=true
# EVENTIDE_DEMO_TARGET_HINT=ISS
